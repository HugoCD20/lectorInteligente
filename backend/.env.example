# Copia este archivo a .env y completa los valores.
# Genera una clave secreta con:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_CORS_ORIGINS=http://localhost:3000,http://localhost:8080
POSTGRES_DB=lector_inteligente
POSTGRES_USER=lector
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
# Nota: el puerto 5433 evita conflictos con el 5432 del host.
# Dentro de Docker el contenedor usa siempre el puerto interno 5432.
POSTGRES_PORT=5433
LIBRETRANSLATE_URL=http://libretranslate:5000
API_PAGE_SIZE=10
# Documentos: tamaño máximo en bytes (50 MB) y extensiones permitidas.
MAX_DOCUMENT_SIZE=52428800
ALLOWED_DOCUMENT_EXTENSIONS=pdf,epub
# En desarrollo se usan emails por consola. En producción configurar SMTP.
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DJANGO_EMAIL_HOST=smtp.example.com
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_HOST_USER=
DJANGO_EMAIL_HOST_PASSWORD=
DJANGO_EMAIL_USE_TLS=True
DJANGO_EMAIL_DEFAULT_FROM=no-reply@lectorinteligente.local
DJANGO_FRONTEND_URL=http://localhost:8080
